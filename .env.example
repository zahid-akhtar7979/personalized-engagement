# Path to Retailrocket CSV files on the host
DATA_IMPORT_PATH=/Users/zahidakhtar/Documents/data

# Ask PEP / Voice SQL — OpenAI (required for LLM-generated SQL; never commit real keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
